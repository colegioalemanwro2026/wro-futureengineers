<path d="M310 500 L310 560" fill="none" stroke="#2C2C2A" stroke-width="1.5" marker-end="url(#arrow)"/>

<!-- Motor -->
<g fill="#FAECE7" stroke="#993C1D"><rect x="60" y="560" width="150" height="70" rx="14" stroke-width="1"/>
<text x="135" y="594" text-anchor="middle" font-size="14" font-weight="500" fill="#4A1B0C">Motor DC</text>
<text x="135" y="610" text-anchor="middle" font-size="12" fill="#712B13">GeekServo</text></g>

<!-- Protoboard con dots -->
<g fill="#F1EFE8" stroke="#5F5E5A"><rect x="270" y="560" width="170" height="150" rx="6" stroke-width="1"/>
<text x="355" y="584" text-anchor="middle" font-size="12" fill="#444441">Protoboard</text>
<circle cx="355" cy="640" r="9" fill="#ffffff" stroke="#5F5E5A" stroke-width="1.5"/>
<text x="355" y="665" text-anchor="middle" font-size="12" fill="#444441">Botón + resistencia</text>
<text x="355" y="680" text-anchor="middle" font-size="12" fill="#444441">Transistores</text>
</g>

<!-- Canal de alimentación (izquierda) -->
<!-- Rojo A: Arduino -->
<path d="M170 760 L15 760 L15 280 L210 280" fill="none" stroke="#E24B4A" stroke-width="1.5"/>
<circle cx="15" cy="650" r="13" fill="#ffffff" stroke="#E24B4A" stroke-width="2"/>
<text x="15" y="654" text-anchor="middle" font-size="12" fill="#791F1F">A</text>
<!-- Rojo B: L298N -->
<path d="M190 760 L35 760 L35 440 L60 440" fill="none" stroke="#E24B4A" stroke-width="1.5"/>
<circle cx="35" cy="600" r="13" fill="#ffffff" stroke="#E24B4A" stroke-width="2"/>
<text x="35" y="604" text-anchor="middle" font-size="12" fill="#791F1F">B</text>
<!-- Negro: GND compartido -->
<path d="M210 760 L50 760 L50 290 L210 290" fill="none" stroke="#2C2C2A" stroke-width="1.5"/>
<path d="M50 460 L60 460" fill="none" stroke="#2C2C2A" stroke-width="1.5"/>

<!-- Batería VEX IQ -->
<g fill="#EAF3DE" stroke="#3B6D11"><rect x="150" y="760" width="320" height="70" rx="8" stroke-width="1"/>
<text x="310" y="799" text-anchor="middle" font-size="14" font-weight="500" fill="#173404">Batería VEX IQ</text></g>

<!-- Leyenda -->
<text x="40" y="855" font-size="12" fill="#5F5E5A">A = botón Arduino (ON/OFF)  ·  B = botón puente H (motor ON/OFF)</text>
<text x="40" y="872" font-size="12" fill="#5F5E5A">Naranja TRIG · Gris ECHO · Amarillo servo · Azul/Verde/Rosa ENA·IN1·IN2 · Rojo/Negro alimentación</text>
</svg>
