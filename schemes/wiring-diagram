</defs>

<!-- SENSORES -->
<g fill="#E1F5EE" stroke="#0F6E56"><rect x="85" y="30" width="140" height="60" rx="6" stroke-width="1"/>
<circle cx="130" cy="58" r="12" fill="#ffffff" stroke="#0F6E56" stroke-width="1"/>
<circle cx="180" cy="58" r="12" fill="#ffffff" stroke="#0F6E56" stroke-width="1"/>
<text x="155" y="80" text-anchor="middle" font-size="12" fill="#085041">Izquierdo</text></g>
<g fill="#E1F5EE" stroke="#0F6E56"><rect x="270" y="30" width="140" height="60" rx="6" stroke-width="1"/>
<circle cx="315" cy="58" r="12" fill="#ffffff" stroke="#0F6E56" stroke-width="1"/>
<circle cx="365" cy="58" r="12" fill="#ffffff" stroke="#0F6E56" stroke-width="1"/>
<text x="340" y="80" text-anchor="middle" font-size="12" fill="#085041">Delantero</text></g>
<g fill="#E1F5EE" stroke="#0F6E56"><rect x="455" y="30" width="140" height="60" rx="6" stroke-width="1"/>
<circle cx="500" cy="58" r="12" fill="#ffffff" stroke="#0F6E56" stroke-width="1"/>
<circle cx="550" cy="58" r="12" fill="#ffffff" stroke="#0F6E56" stroke-width="1"/>
<text x="525" y="80" text-anchor="middle" font-size="12" fill="#085041">Derecho</text></g>

<!-- Cables TRIG/ECHO sensores -> arduino -->
<path d="M120 90 L200 190" fill="none" stroke="#BA7517" stroke-width="1.5" marker-end="url(#arrow)"/>
<path d="M140 90 L215 190" fill="none" stroke="#888780" stroke-width="1.5" marker-end="url(#arrow)"/>
<path d="M305 90 L320 190" fill="none" stroke="#BA7517" stroke-width="1.5" marker-end="url(#arrow)"/>
<path d="M325 90 L335 190" fill="none" stroke="#888780" stroke-width="1.5" marker-end="url(#arrow)"/>
<path d="M490 90 L440 190" fill="none" stroke="#BA7517" stroke-width="1.5" marker-end="url(#arrow)"/>
<path d="M510 90 L455 190" fill="none" stroke="#888780" stroke-width="1.5" marker-end="url(#arrow)"/>

<!-- ARDUINO -->
<g fill="#EEEDFE" stroke="#534AB7"><rect x="210" y="190" width="260" height="110" rx="8" stroke-width="1"/>
<rect x="220" y="196" width="240" height="8" rx="2" fill="#534AB7" opacity="0.5"/>
<rect x="220" y="296" width="240" height="8" rx="2" fill="#534AB7" opacity="0.5"/>
<text x="340" y="252" text-anchor="middle" font-size="14" font-weight="500" fill="#26215C">Arduino Uno R4 WiFi</text></g>

<!-- Cables ENA/IN1/IN2 arduino -> L298N -->
<path d="M240 300 L100 400" fill="none" stroke="#378ADD" stroke-width="1.5" marker-end="url(#arrow)"/>
<path d="M260 300 L130 400" fill="none" stroke="#639922" stroke-width="1.5" marker-end="url(#arrow)"/>
<path d="M280 300 L160 400" fill="none" stroke="#D4537E" stroke-width="1.5" marker-end="url(#arrow)"/>
