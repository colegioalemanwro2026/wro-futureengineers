<text x="180" y="447" text-anchor="middle" font-size="12" fill="#712B13">ENA4 IN1·6 IN2·5</text></g>

<!-- Nicla Vision -->
<g fill="#FAEEDA" stroke="#854F0B"><rect x="270" y="400" width="90" height="100" rx="6" stroke-width="1"/>
<circle cx="315" cy="425" r="10" fill="#ffffff" stroke="#854F0B" stroke-width="1"/>
