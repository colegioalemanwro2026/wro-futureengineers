<path d="M350 300 L310 400" fill="none" stroke="#27500A" stroke-width="1.5" marker-end="url(#arrow)"/>
<!-- Cable señal arduino -> servo -->
<path d="M430 300 L440 400" fill="none" stroke="#EF9F27" stroke-width="1.5" marker-end="url(#arrow)"/>

<!-- L298N -->
<g fill="#FAECE7" stroke="#993C1D"><rect x="60" y="400" width="180" height="80" rx="6" stroke-width="1"/>
<rect x="72" y="412" width="40" height="40" rx="3" fill="#993C1D" opacity="0.5"/>
