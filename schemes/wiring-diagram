<rect x="400" y="400" width="80" height="60" rx="6" stroke-width="1"/>
<text x="440" y="435" text-anchor="middle" font-size="12" fill="#4B1528">Servo</text></g>

<!-- Cables L298N -> Motor -->
<path d="M100 480 L90 560" fill="none" stroke="#E24B4A" stroke-width="1.5" marker-end="url(#arrow)"/>
<path d="M120 480 L110 560" fill="none" stroke="#2C2C2A" stroke-width="1.5" marker-end="url(#arrow)"/>
